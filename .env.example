# Required infrastructure
TELEGRAM_TOKEN=
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Optional deployment settings
PORT=8080
APP_URL=
DASHBOARD_PASSWORD=
LOG_LEVEL=INFO

# Live Trading & Safety Settings
LIVE_TRADING=true
TEST_MODE=false
TEST_MAX_TRADE_NGN=500
TEST_MIN_BANKROLL=1000

# Risk rails (fractions: 0.10 = 10%)
MAX_DRAWDOWN_STOP=0.10
MAX_PORTFOLIO_EXPOSURE=0.15
MAX_TRADE_RISK=0.02
DEFAULT_DAILY_LOSS_LIMIT_PCT=3.0
MAX_DAILY_LOSS_LIMIT_PCT=5.0
TRADING_TIMEZONE=Africa/Lagos
REQUIRE_DIRECT_ORACLE=true
ALLOW_EXPERIMENTAL_STRATEGIES=false

# Reliability / API
API_REQUEST_TIMEOUT_SEC=12
API_CONNECT_TIMEOUT_SEC=4
API_READ_RETRIES=3
FEED_STALE_SEC=30
LOCK_LEASE_SEC=45
# Rolling updates: a new container stands by (alive, answering /live, never
# /ready) until the old one releases the lease. 0 = stand by forever.
LOCK_ACQUIRE_RETRY_SEC=5
LOCK_ACQUIRE_TIMEOUT_SEC=900
# Database startup is retried inside this window instead of killing the process.
# init_db raising used to exit in under a second, before /live answered a single
# health probe, so a briefly unreachable Postgres failed the deploy. 0 = retry
# forever. Keep the timeout at or above the platform's probe grace period
# (the Dockerfile HEALTHCHECK uses --start-period=90s).
DB_INIT_RETRY_SEC=5
DB_INIT_TIMEOUT_SEC=120

# Drought visibility (alerts the operator with the reason; never forces a trade)
TRADE_STALL_ALERT_MINUTES=120
TRADE_STALL_ALERT_REPEAT_MINUTES=360
STALL_EVAL_MAX_AGE_SEC=180

# Strategy overrides
SNIPE_ALLOWED_ASSETS=BTC,ETH,SOL
SNIPE_ALLOWED_TIMEFRAMES=15min,5min
COMPLETE_SET_MIN_EDGE=0.02
CLOB_MAX_BOOK_AGE_SECONDS=5
FRONTRUN_BIAS_TRIGGER=0.0003
