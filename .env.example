# Required infrastructure
TELEGRAM_TOKEN=
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Optional deployment settings
PORT=8080
APP_URL=
DASHBOARD_PASSWORD=
LOG_LEVEL=INFO

# Safety defaults. Real orders require an explicit opt-in after dry-run checks.
LIVE_TRADING=false
TEST_MODE=false
TEST_MAX_TRADE_NGN=500
TEST_MIN_BANKROLL=1000

# Risk rails (fractions: 0.10 = 10%)
MAX_DRAWDOWN_STOP=0.10
MAX_PORTFOLIO_EXPOSURE=0.15
MAX_TRADE_RISK=0.02
DEFAULT_DAILY_LOSS_LIMIT_PCT=3.0
MAX_DAILY_LOSS_LIMIT_PCT=5.0
TRADING_TIMEZONE=Africa/Lagos
REQUIRE_DIRECT_ORACLE=true
ALLOW_EXPERIMENTAL_STRATEGIES=false

# Reliability / API
API_REQUEST_TIMEOUT_SEC=12
API_CONNECT_TIMEOUT_SEC=4
API_READ_RETRIES=3
FEED_STALE_SEC=30
LOCK_LEASE_SEC=45

# Strategy override (optional)
FRONTRUN_BIAS_TRIGGER=0.0003
